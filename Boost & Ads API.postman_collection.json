    "item": [
        {
            "name": "🚀 Boost Plans",
            "description": "Admin endpoints for managing product boost/promotion plans. Boost plans control how long and for what price a product gets visibility boosts.\n\nBase URL: {{baseUrl}}/admin/boost-plans\n\nAuthentication: Bearer {{adminToken}} in Authorization header",
            "item": [
                {
                    "name": "List All Boost Plans",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/boost-plans",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "boost-plans"]
                        },
                        "description": "Returns all boost plans sorted by price ascending. Each plan includes: id, name, price, durationHours, description, isActive, createdAt, updatedAt."
                    },
                    "response": [
                        {
                            "name": "Boost Plans List Response",
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n    \"success\": true,\n    \"statusCode\": 200,\n    \"message\": \"Boost plans fetched successfully.\",\n    \"data\": [\n        {\n            \"_id\": \"664f1a2b3c4d5e6f7a8b9c0d\",\n            \"name\": \"Basic Boost\",\n            \"price\": 2,\n            \"durationHours\": 24,\n            \"description\": \"Visibility for 24h\",\n            \"isActive\": true,\n            \"createdAt\": \"2025-01-15T10:30:00.000Z\",\n            \"updatedAt\": \"2025-06-01T14:22:00.000Z\",\n            \"id\": \"664f1a2b3c4d5e6f7a8b9c0d\"\n        },\n        {\n            \"_id\": \"664f1a2b3c4d5e6f7a8b9c0e\",\n            \"name\": \"Standard Boost\",\n            \"price\": 5,\n            \"durationHours\": 72,\n            \"description\": \"Visibility for 3 days\",\n            \"isActive\": true,\n            \"createdAt\": \"2025-01-15T10:30:00.000Z\",\n            \"updatedAt\": \"2025-06-01T14:22:00.000Z\",\n            \"id\": \"664f1a2b3c4d5e6f7a8b9c0e\"\n        }\n    ]\n}"
                        }
                    ]
                },
