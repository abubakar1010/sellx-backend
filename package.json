{
    "name": "backend-mongoose-template",
    "version": "1.0.0",
    "private": true,
    "description": "Production-grade backend template with Express, Mongoose, Redis, and clean architecture.",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "dev": "nodemon",
        "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
        "start": "node dist/src/server.js",
        "start:prod": "npm run build && npm run start",
        "seed:super-admin": "ts-node -r tsconfig-paths/register ./src/seeds/superAdmin.seed.ts",
        "seed:categories": "ts-node -r tsconfig-paths/register ./src/seeds/categories.seed.ts",
        "seed:products": "ts-node -r tsconfig-paths/register ./src/seeds/products.seed.ts",
        "seed:boost-plans": "ts-node -r tsconfig-paths/register ./src/seeds/boost-plans.seed.ts",
        "seed:ads-plans": "ts-node -r tsconfig-paths/register ./src/seeds/ads-packages.seed.ts",
        "seed:admin-notifications": "ts-node -r tsconfig-paths/register ./src/seeds/adminNotifications.seed.ts",
        "seed:payments": "ts-node -r tsconfig-paths/register ./src/seeds/payments.seed.ts",
        "seed:stories": "ts-node -r tsconfig-paths/register ./src/seeds/stories.seed.ts",
        "seed:listing-packages": "ts-node -r tsconfig-paths/register ./src/seeds/listing-packages.seed.ts",
        "seed:all": "ts-node -r tsconfig-paths/register ./src/seeds/seed-all.ts",
        "backfill:user-address": "ts-node -r tsconfig-paths/register ./src/seeds/backfill-user-address.seed.ts",
        "migrate:currency-nok": "ts-node -r tsconfig-paths/register ./src/seeds/migrate-currency-to-nok.seed.ts",
        "migrate:product-fields": "ts-node -r tsconfig-paths/register ./src/seeds/migrate-product-fields.seed.ts",
        "audit:vehicle-brands": "ts-node -r tsconfig-paths/register ./src/seeds/audit-vehicle-brands.seed.ts",
        "setup:https:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-local-https.ps1",
        "setup:https:starter": "npm run setup:https:windows -- -Domain starter-mongoose.localhost && docker compose restart nginx",
        "docker:up": "docker compose up --build",
        "docker:up:https:windows": "npm run setup:https:windows && docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:down:volumes": "docker compose down -v",
        "docker:prod": "docker compose --profile prod up --build",
        "verify:integrity": "node scripts/check-integrity.mjs",
        "docs:listing": "node scripts/build-listing-docs.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "npm run verify:integrity && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "test": "jest --runInBand --detectOpenHandles",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@socket.io/redis-adapter": "^8.3.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.70.1",
        "cloudinary": "^2.9.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "ejs": "^4.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "firebase-admin": "^13.10.0",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "ioredis": "^5.9.3",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.2.3",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "nodemailer": "^10.0.10",
        "redis": "^5.11.0",
        "socket.io": "^4.8.1",
        "stripe": "^22.3.0",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/hpp": "^0.2.7",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.3.2",
        "@types/nodemailer": "^7.0.11",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.2.0",
        "nodemon": "^3.1.14",
        "npm-check-updates": "^19.6.2",
        "prettier": "^3.8.1",
        "socket.io-client": "^4.8.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    }
}
